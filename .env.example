# ============================================================
# TaskMate AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=TaskMate API
APP_VERSION=0.1.0

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Database ----
POSTGRES_USER=taskmate
POSTGRES_PASSWORD=taskmate_dev_password
POSTGRES_DB=taskmate
DATABASE_URL=postgresql+asyncpg://taskmate:taskmate_dev_password@postgres:5432/taskmate

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
# Future Configuration (Sprint 1+)
# Do NOT set these for Sprint 0 — the app does not require them.
# ============================================================

# ---- AI Provider ----
# AI_PROVIDER=openai
# AI_MODEL=gpt-4
# AI_API_KEY=sk-your-api-key-here
# AI_BASE_URL=

# ---- GitHub ----
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---- Email ----
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
