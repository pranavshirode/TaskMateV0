# ============================================================
# TaskMate AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to source control.
# ============================================================

# ---- Application ----
APP_ENV=development
APP_NAME=TaskMate API
APP_VERSION=0.1.0

# ---- Backend ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---- Database ----
POSTGRES_USER=taskmate
POSTGRES_PASSWORD=taskmate_dev_password
POSTGRES_DB=taskmate
DATABASE_URL=postgresql+asyncpg://taskmate:taskmate_dev_password@postgres:5432/taskmate

# ---- CORS ----
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000"]

# ---- Logging ----
LOG_LEVEL=INFO
# Log every SQL statement with its parameters (includes client data). Keep false unless debugging.
SQL_ECHO=false

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- API Security ----
# Required. Generate with: openssl rand -hex 32
# The app refuses to start with the built-in default when APP_ENV is not development/testing.
SECRET_KEY=development-only-change-me


# ---- AI Provider ----
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=sk-your-api-key-here
AI_BASE_URL=
AI_TIMEOUT=30
AI_MAX_RETRIES=3
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=2000
AI_RATE_LIMIT_PER_MINUTE=30

# ---- Agent Configuration ----
AGENT_MAX_STEPS=10
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_EXECUTION_TIME=120
AGENT_REQUIRE_APPROVAL_FOR_WRITES=true

# ---- GitHub Integration ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/settings/integrations/github/callback
GITHUB_ENCRYPTION_KEY=

# ---- Email ----
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
